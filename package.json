{
  "name": "sigem-pyme",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "db:seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
